---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConsentMode from '../components/ConsentMode.astro';
import CookieBanner from '../components/CookieBanner.astro';
import logo from '../assets/logo.png';
import { site } from '../data/site';

// breadcrumb: Name der Seite für BreadcrumbList; service: Service-Schema für Leistungsseiten
interface Props { title: string; description: string; noindex?: boolean; cta?: string; landing?: boolean; breadcrumb?: string; service?: { name: string; serviceType: string } }
const { title, description, noindex, cta, landing, breadcrumb, service } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Strukturierte Daten: Unternehmen (lokales SEO) + Website, auf jeder Seite gleich
const home = new URL('/', Astro.site).href;
const orgId = `${home}#organization`;
// Feste Logo-URL (public/logo.png), damit sie sich nicht mit jedem Build ändert
const logoUrl = new URL('/logo.png', Astro.site).href;
const geo = { '@type': 'GeoCoordinates', ...site.geo };
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'ProfessionalService'],
      '@id': orgId,
      name: site.name,
      legalName: site.legalName,
      url: home,
      logo: logoUrl,
      image: logoUrl,
      geo,
      hasMap: site.googleMaps,
      sameAs: [site.googleMaps],
      telephone: site.phoneHref.replace('tel:', ''),
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.street,
        postalCode: site.postalCode,
        addressLocality: site.locality,
        addressRegion: 'Bayern',
        addressCountry: 'DE',
      },
      openingHoursSpecification: site.openingHours.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.days,
        opens: h.opens,
        closes: h.closes,
      })),
      areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
      knowsAbout: ['WEG-Verwaltung', 'Mietverwaltung', 'Sondereigentumsverwaltung', 'Hausverwaltung'],
    },
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name, inLanguage: 'de-DE', publisher: { '@id': orgId } },
    ...(breadcrumb ? [{
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: home },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical.href },
      ],
    }] : []),
    ...(service ? [{
      '@type': 'Service',
      '@id': `${canonical.href}#service`,
      name: service.name,
      serviceType: service.serviceType,
      url: canonical.href,
      provider: { '@id': orgId },
      areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
    }] : []),
  ],
};
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <ConsentMode />
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#5797F5">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/belleza-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  {landing ? (
    <header class="nav">
      <div class="nav-in">
        <a class="logo" href="/" aria-label="Immovent Startseite"><Image src={logo} alt={site.name} height={44} densities={[1, 2]} loading="eager" fetchpriority="high" /></a>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
          <span class="muted portal" style="font-size: 14px">Mo–Do 9–15 Uhr, Fr 9–13 Uhr</span>
          <a class="btn btn-g" href={site.phoneHref}><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{site.phone}</span></a>
        </div>
      </div>
    </header>
  ) : <Nav cta={cta} />}
  <main><slot /></main>
  {landing ? (
    <footer class="foot" style="padding: 32px 0">
      <div class="wrap" style="display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px">
        <span>© {new Date().getFullYear()} Immovent Hausverwaltung GmbH · {site.street}, {site.city}</span>
        <div style="display: flex; gap: 24px"><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><button type="button" class="cb-link" data-cookie-settings>Cookie-Einstellungen</button></div>
      </div>
    </footer>
  ) : <Footer />}
  <CookieBanner />
  <script>
    import { trackLanding, sendLead } from '../scripts/lead';
    trackLanding();
    // Kontaktformular: in die Lead-Liste schreiben, dann zur Danke-Seite
    document.querySelectorAll<HTMLFormElement>('form[action="/danke-seite"]').forEach((f) =>
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = f.querySelector<HTMLButtonElement>('[type="submit"]')!;
        btn.disabled = true;
        sendLead(f)
          .then(() => (location.href = f.getAttribute('action')!))
          .catch(() => {
            btn.disabled = false;
            btn.insertAdjacentHTML('afterend', '<span class="hint" role="alert">Senden fehlgeschlagen. Bitte versuchen Sie es erneut oder rufen Sie uns an.</span>');
          });
      })
    );
  </script>
</body>
</html>
