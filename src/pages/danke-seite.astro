---
import Base from '../layouts/Base.astro';
---
<Base noindex title="Vielen Dank für Ihre Anfrage | Immovent Hausverwaltung" description="Wir haben Ihre Anfrage erhalten und melden uns in der Regel innerhalb von 24 Stunden.">

<section style="min-height: calc(100dvh - 76px); display: flex; align-items: center; padding: 96px 0">
<div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px">
<h1 style="max-width: 640px">Vielen Dank<br> für Ihre Anfrage!</h1>
<p class="lead" style="max-width: 560px">Wir haben Ihre Anfrage erfolgreich erhalten und werden uns schnellstmöglich bei Ihnen melden, werktags innerhalb von 24&nbsp;Stunden.</p>
<a class="btn btn-p" href="/" style="min-width: 240px; margin-top: 12px">Zur Startseite</a>
</div>
</section>

</Base>
