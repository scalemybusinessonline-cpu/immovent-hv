---
import Base from '../layouts/Base.astro';
---
<Base noindex title="Vielen Dank für Ihre Anfrage | Immovent Hausverwaltung" description="Wir haben Ihre Anfrage erhalten und melden uns in der Regel innerhalb von 24 Stunden.">

<section style="min-height:calc(100dvh - 72px);display:flex;align-items:center;padding:96px 0">
  <div class="wrap stack" style="align-items:center;text-align:center;gap:28px">
    <h1 class="fade-up h1" style="max-width:640px">Vielen Dank<br> für Ihre Anfrage!</h1>
    <p class="fade-up d1 muted lead" style="max-width:560px">Wir haben Ihre Anfrage erfolgreich erhalten und werden uns schnellstmöglich bei Ihnen melden – in der Regel innerhalb von 24&nbsp;Stunden.</p>
    <a class="fade-up d2 btn btn-p" href="/" style="min-width:240px;margin-top:12px">Zur Startseite</a>
  </div>
</section>

</Base>
