---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import altbau from '../assets/altbau-fassade.webp';
---
<Base title="Kontakt & Erstgespräch | Immovent Hausverwaltung Bamberg" description="Neue Hausverwaltung gesucht? Immovent übernimmt WEG- und Mietverwaltung in Bamberg und Umgebung – persönlich und lösungsorientiert. Jetzt anfragen!" cta="#formular">

<section style="padding: 88px 0 112px">
<div class="wrap">
<div class="head">
<div class="eyebrow">Kontakt</div>
<h1>Sprechen wir über Ihre Immobilie.</h1>
<p class="lead">Füllen Sie das Formular aus, wir melden uns werktags innerhalb von 24 Stunden. Oder rufen Sie uns einfach direkt an.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 64px; align-items: flex-start">
<div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 32px; min-width: 0">
<div style="display: flex; flex-direction: column; border-top: 1px solid #E3E7EE">
<a href="tel:+4915174530871" style="display: flex; gap: 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid #E3E7EE; text-decoration: none; color: #16202E"><span class="ic-box"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="muted" style="display: block; font-size: 13px">Telefon</span><span style="font-size: 17px; font-weight: 600">0151 74530871</span></span></a>
<a href="mailto:info@immovent-hv.de" style="display: flex; gap: 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid #E3E7EE; text-decoration: none; color: #16202E"><span class="ic-box"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 014.5 5h15A1.5 1.5 0 0121 6.5v11a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 17.5zM3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="muted" style="display: block; font-size: 13px">E-Mail</span><span style="font-size: 17px; font-weight: 600">info@immovent-hv.de</span></span></a>
<div style="display: flex; gap: 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid #E3E7EE"><span class="ic-box"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21zM12 7a2.5 2.5 0 110 5 2.5 2.5 0 010-5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="muted" style="display: block; font-size: 13px">Büro</span><span style="font-size: 17px; font-weight: 600">Schützenstr. 21, 96047 Bamberg</span></span></div>
</div>
<div class="card" style="padding: 24px 28px; background: #EFF5FE; border-color: #EFF5FE">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px"><h3 style="font-size: 18px">Bürozeiten</h3></div>
<div class="row" style="border-bottom-color: #E3E7EE"><span class="muted">Montag – Donnerstag</span><span style="font-weight: 600">09:00 – 15:00</span></div>
<div class="row" style="border-bottom-color: #E3E7EE"><span class="muted">Freitag</span><span style="font-weight: 600">09:00 – 13:00</span></div>
<div class="row" style="border-bottom-color: #E3E7EE"><span class="muted">Termine außerhalb</span><span style="font-weight: 600">nach Vereinbarung</span></div>
<div class="row"><span class="muted">Notfälle</span><span style="font-weight: 600; text-align: right">Notfallnummer des Fachbetriebs für Ihr Objekt</span></div>
</div>
<Picture formats={['avif', 'webp']} class="photo" src={altbau} alt="Altbaufassaden in der Stadt" loading="lazy" style="height: 280px" widths={[700, 1380]} sizes="(max-width: 900px) 100vw, 600px" />
</div>
<div id="formular" class="card" style="flex: 1.4 1 480px; padding: 40px; min-width: 0">
<h2 style="font-size: 32px; margin-bottom: 28px">Erstgespräch anfragen</h2>
<ContactForm />
</div>
</div>
</div>
</section>

</Base>
