---
import Base from '../layouts/Base.astro';
import Check from '../components/Check.astro';
import Arrow from '../components/Arrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Roof from '../components/Roof.astro';
import { site } from '../data/site';

const tasks = [
  { t: 'Wasserhahn tropft – WE 3', s: 'Installateur beauftragt', chip: 'wip', l: 'In Arbeit', bg: '#FFF1DC', fg: '#8A4B00', icon: '<path d="M12 3c3 4 6 7 6 11a6 6 0 01-12 0c0-4 3-7 6-11z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>' },
  { t: 'Besichtigung WE 5', s: '6 Interessenten · Bonität geprüft', chip: 'new', l: 'Termin', bg: '#EAF2FE', fg: '#2563C9', icon: '<path d="M4 11l8-6 8 6v9H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>' },
  { t: 'Betriebskostenabrechnung', s: 'An alle Mieter versendet', chip: 'ok', l: 'Erledigt', bg: '#E3F5EC', fg: '#11663F', icon: '<path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' },
];

const services = [
  { h: 'Mieterbetreuung', items: ['Zentraler Ansprechpartner für Mieter, Hausmeister & Dienstleister', 'Lösungsorientierte Bearbeitung aller Anliegen', 'Transparente Dokumentation aller Vorgänge'] },
  { h: 'Mietbuchhaltung & Abrechnung', items: ['Überwachung der Mieteingänge & Mahnwesen', 'Betriebskostenabrechnung nach BetrKV', 'Kautionsverwaltung'] },
  { h: 'Handwerkerkoordination', items: ['Einholung & Vergleich von Angeboten', 'Koordination zwischen Handwerkern & Mietern', 'Lückenlose Nachverfolgung aller Maßnahmen'] },
];

const steps = [
  ['Vermarktung', 'Exposé und Anzeigen auf den relevanten Plattformen.'],
  ['Besichtigungen', 'Organisation und Durchführung der Termine vor Ort.'],
  ['Mieterauswahl', 'Sorgfältige Prüfung inklusive Bonitätsauskunft – Sie erhalten eine Empfehlung.'],
  ['Vertrag & Übergabe', 'Mietvertrag, Übergabeprotokoll und Zählerstände – sauber dokumentiert.'],
];

const faq = [
  { q: 'Verwalten Sie auch einzelne Eigentumswohnungen?', a: '[Ja / ab X Einheiten – bitte ergänzen]' },
  { q: 'Wer entscheidet über Reparaturen?', a: 'Kleinere Reparaturen beauftragen wir im vereinbarten Rahmen direkt. Größere Maßnahmen stimmen wir vorab mit Ihnen ab – mit Vergleichsangeboten.' },
  { q: 'Wie behalte ich den Überblick?', a: 'Über das Kundenportal sehen Sie Dokumente, Abrechnungen und laufende Vorgänge. Zusätzlich erhalten Sie regelmäßige Updates von Ihrem Ansprechpartner.' },
];
---
<Base title="Mietverwaltung Bamberg – für Vermieter & Investoren | Immovent" description="Mietverwaltung in Bamberg und Umgebung: Mieterbetreuung, Neuvermietung mit Bonitätsprüfung, Betriebskostenabrechnung und Handwerkerkoordination aus einer Hand.">

<section style="position:relative;overflow:hidden;padding:88px 0 80px">
  <div class="gridbg" aria-hidden="true"></div>
  <Roof />
  <div class="wrap grid2" style="position:relative;gap:56px;align-items:center">
    <div class="stack" style="gap:26px">
      <nav class="fade-up" aria-label="Breadcrumb" style="display:flex;gap:8px;align-items:center;font-size:14px"><a href="/" style="text-decoration:none">Start</a><span aria-hidden="true" class="muted">/</span><span class="muted">Mietverwaltung</span></nav>
      <h1 class="fade-up d1 h1">Mietverwaltung in Bamberg und Umgebung</h1>
      <p class="fade-up d2 muted lead" style="max-width:540px">Wir übernehmen die Verwaltung Ihres Mehrfamilienhauses oder Ihrer Anlageimmobilie vollständig – Sie behalten den Überblick, ohne im Tagesgeschäft eingebunden zu sein.</p>
      <div class="fade-up d3" style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-p" href="/kontakt">Erstgespräch vereinbaren</a>
        <a class="btn btn-g" href="#neuvermietung">Neuvermietung</a>
      </div>
    </div>
    <div class="fade-up d3" style="position:relative;padding:16px 8px 48px" aria-hidden="true">
      <div class="card stack" style="padding:24px;box-shadow:0 40px 80px -32px rgba(20,20,20,.28);gap:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div style="font-weight:700;font-size:17px">Vorgänge diese Woche</div><span class="chip new">4 offen</span></div>
        {tasks.map((x) => (
          <div style="display:flex;gap:14px;align-items:center;padding:14px;border-radius:14px;background:#F6F7FA">
            <div style={`flex:none;width:40px;height:40px;border-radius:12px;background:${x.bg};color:${x.fg};display:flex;align-items:center;justify-content:center`}><svg width="18" height="18" viewBox="0 0 24 24" set:html={x.icon} /></div>
            <div style="flex:1;min-width:0"><div style="font-weight:600;font-size:15px">{x.t}</div><div class="muted" style="font-size:13px">{x.s}</div></div>
            <span class={`chip ${x.chip}`}>{x.l}</span>
          </div>
        ))}
      </div>
      <div class="card float" style="position:absolute;right:-6px;bottom:6px;padding:14px 18px;box-shadow:0 20px 40px -16px rgba(20,20,20,.25)"><div class="muted" style="font-size:12px">Mieteingang Oktober</div><div style="font-size:22px;font-weight:700;letter-spacing:-.02em;margin-top:2px">vollständig</div></div>
    </div>
  </div>
</section>

<section style="padding:90px 0">
  <div class="wrap">
    <SectionHead eyebrow="Leistungsumfang" title="Alles, was Ihre Mietimmobilie braucht" />
    <div class="grid3" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
      {services.map((s) => (
        <div class="card hov sr stack" style="padding:32px;gap:18px">
          <h3 style="font-size:22px">{s.h}</h3>
          <div class="stack" style="gap:10px">{s.items.map((it) => <Check>{it}</Check>)}</div>
        </div>
      ))}
      <div class="card hov sr blue stack full" style="padding:32px;gap:18px;min-width:0">
        <h3 style="font-size:22px">Direkte Eigentümerbetreuung</h3>
        <p style="font-size:16px;line-height:1.6;max-width:560px">Digitaler Zugang zu allen Dokumenten und Abrechnungen, ein persönlicher Ansprechpartner, verbindliche Rückmeldungen und regelmäßige Updates zu Ihrem Objekt.</p>
        <a href={site.portal} style="color:#fff;font-weight:600;text-decoration:none;display:inline-flex;gap:8px;align-items:center;margin-top:auto">Zum Kundenportal <Arrow /></a>
      </div>
    </div>
  </div>
</section>

<section id="neuvermietung" class="band" style="padding:90px 0">
  <div class="wrap grid2" style="gap:64px;align-items:start">
    <div class="sr stack" style="gap:16px;position:sticky;top:100px">
      <div class="eyebrow">Neuvermietung</div>
      <h2 class="h2">Kurze Leerstände, passende Mieter.</h2>
      <p class="muted" style="font-size:18px;line-height:1.6">Von der Anzeige bis zur Wohnungsübergabe – Sie entscheiden nur noch über den Mieter.</p>
    </div>
    <ol class="stack" style="list-style:none;margin:0;padding:0">
      {steps.map(([t, d], i) => {
        const last = i === steps.length - 1;
        return (
          <li class="sr" style={`display:flex;gap:20px;${last ? '' : 'padding-bottom:32px'}`}>
            <div class="stack" style="align-items:center">
              <div style={`width:40px;height:40px;border-radius:50%;background:${last ? '#2563C9' : '#5797F5'};color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px`}>{i + 1}</div>
              {!last && <div style="flex:1;width:2px;background:#E4E5E9;margin-top:8px"></div>}
            </div>
            <div class="stack" style="padding-top:8px;gap:6px"><div style="font-size:19px;font-weight:700">{t}</div><p class="muted" style="font-size:15px;line-height:1.6">{d}</p></div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<section style="padding:110px 0">
  <div class="wrap grid2" style="gap:64px;align-items:start">
    <div class="sr stack" style="gap:16px">
      <div class="eyebrow">FAQ Mietverwaltung</div>
      <h2 class="h2">Häufige Fragen von Vermietern</h2>
    </div>
    <Faq name="faq-miet" items={faq} />
  </div>
</section>

<CtaBanner ring title="Bereit, Ihre Immobilie in professionelle Hände zu geben?" text="Wir nehmen uns Zeit für Ihr Objekt – vereinbaren Sie ein unverbindliches Erstgespräch." />

</Base>
