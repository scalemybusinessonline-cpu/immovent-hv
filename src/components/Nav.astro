---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { nav, site } from '../data/site';

interface Props { cta?: string }
const { cta = '/kontakt' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="nav">
  <div class="nav-in">
    <a class="logo" href="/" aria-label="Immovent Startseite">
      <Image src={logo} alt={site.name} height={44} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>
    <nav class="links" aria-label="Hauptnavigation">
      {nav.map((l) => (
        <a href={l.href} class:list={{ on: path === l.href }} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-g portal" href={site.portal}>Kundenportal</a>
      <a class="btn btn-p" href={cta}>Erstgespräch</a>
      <button class="btn btn-g icon-btn menu-btn" type="button" aria-label="Menü" aria-expanded="false" aria-controls="mnav"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
    </div>
  </div>
  <nav class="mnav" id="mnav" aria-label="Mobile Navigation" hidden>
    {nav.map((l) => (
      <a href={l.href} class:list={{ on: path === l.href }} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={site.portal}>Kundenportal</a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('mnav')!;
  const toggle = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => toggle(menu.hidden));
  // Menü schließen, wenn ein Anker auf derselben Seite angeklickt wird
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) toggle(false);
  });
</script>
