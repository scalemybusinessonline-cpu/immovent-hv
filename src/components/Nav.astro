---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ctaHref = path === '/' ? '#anfrage' : '/kontakt';
---
<header class="nav">
  <div class="nav-in">
    <a class="logo" href="/" aria-label="Immovent Startseite">
      <Image src={logo} alt={site.name} height={46} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>
    <nav class="links" aria-label="Hauptnavigation">
      {nav.map((l) => (
        <a href={l.href} class:list={{ on: path === l.href }} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-g" href={site.portal}>Kundenportal</a>
      {path !== '/kontakt' && <a class="btn btn-p" href={ctaHref}>Erstgespräch</a>}
    </div>
    <button class="burger" type="button" popovertarget="mnav" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
    <div id="mnav" popover>
      <nav class="mlinks" aria-label="Mobile Navigation">
        {nav.map((l) => (
          <a href={l.href} class:list={{ on: path === l.href }} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <div class="stack" style="gap:10px">
        {path !== '/kontakt' && <a class="btn btn-p" href={ctaHref}>Erstgespräch vereinbaren</a>}
        <a class="btn btn-g" href={site.portal}>Kundenportal</a>
        <a class="mphone" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Menü schließen, wenn ein Anker auf derselben Seite angeklickt wird (z. B. #anfrage)
  const m = document.getElementById('mnav');
  m?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) m.hidePopover();
  });
</script>
